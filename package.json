{
  "name": "bebotter2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations && cp -r src/db/migrations/. dist/db/migrations/ && mkdir -p dist/admin/assets && cp -r src/admin/assets/. dist/admin/assets/",
    "test": "vitest run",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "bot-def": "tsx src/bots/cli.ts"
  },
  "dependencies": {
    "@microsoft/agents-hosting": "1.9.1",
    "@microsoft/agents-hosting-express": "1.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.83",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "express": "4.22.3",
    "jose": "6.2.13",
    "mssql": "12.7.7",
    "mysql2": "3.24.4",
    "openai": "^7.51.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^4.17.25",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
