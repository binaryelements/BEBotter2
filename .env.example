# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/bebotter2
# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-placeholder
# 32 random bytes, base64 (openssl rand -base64 32)
SECRETS_KEY=replace-with-base64-32-bytes
# Bot display name (default: BE Bot)
BOT_NAME=BE Bot
# Default model id (default: claude-haiku-5-5)
DEFAULT_MODEL=claude-haiku-5-5
# HTTP port (default: 3978)
PORT=3978
# Microsoft Entra app client id (name is read by the Agents SDK)
clientId=00000000-0000-0000-0000-000000000000
# Microsoft Entra tenant id (name is read by the Agents SDK)
tenantId=00000000-0000-0000-0000-000000000000
# Microsoft Entra client secret (name is read by the Agents SDK)
clientSecret=replace-me
# Docker image for the computer sandbox (default: bebotter2-computer)
COMPUTER_IMAGE=bebotter2-computer
# Docker socket path (default: /var/run/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock
